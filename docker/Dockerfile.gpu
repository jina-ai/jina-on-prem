# Jina AI Model: On-Prem Docker Image, GPU variant
# Phase 1, bundle: bakes model weights and model-specific deps into image.
# Phase 2, deploy: runs fully offline, zero external network calls.
#
# torch and the CUDA runtime come from the PyTorch cu126 wheel index, which
# ships CUDA as nvidia-*-cu12 packages, so the host supplies only the driver.
# All model dependency versions are pinned in catalog.json and written to
# model-requirements.txt at bundle time.

ARG MODEL_ID=jinaai/jina-embeddings-v5-text-nano
ARG MODEL_REVISION=""
ARG HF_TOKEN=""
# Default GPU dtype for the encode loop. Override per model via --build-arg
# DTYPE=float32 for models that produce NaN/Inf under fp16 (e.g. jina-bert
# ALiBi variants — v1/v2-base series).
ARG DTYPE=float16

# Cross-request batching. Off for the plain :gpu image, which keeps the
# one-request-at-a-time behaviour it has always had; the throughput variant
# bakes BATCH=1. Same server, same contract either way -- batching only
# changes which rows share a forward pass.
ARG BATCH=0

# Which Wolfi base to build on. `public` is Chainguard's wolfi-base, which
# anyone can pull. `official` is the distroless Wolfi Python the published
# images are built from, which needs an Elastic login to pull. Only the base
# stages below differ; BuildKit pulls just the pair the build uses.
ARG BASE=public

# ---------------------------------------------------------------------------
# Bases
# The builder and runtime move as a pair: the venv names /usr/bin/python3.11,
# and a runtime built from a different CPython breaks it with no build error.
# The public builder is built on the public runtime for the same reason.
# ---------------------------------------------------------------------------
FROM docker.elastic.co/wolfi/python:3.11-dev@sha256:0a6c4910b95218fea4595501c16d9e9c6aa254fb87769ffe4021b2045cb2e0ac AS builder-official
FROM docker.elastic.co/wolfi/python:3.11@sha256:feeaf4b7d638021401474d8cfc74770a65ab40e23a2980bbc4837c60127af068 AS runtime-official

FROM cgr.dev/chainguard/wolfi-base@sha256:08df5982c3d27e70a4ce1607e3bb9af09d746f8722cf135a7694afef879fc5a2 AS runtime-public
RUN apk add --no-cache python-3.11
FROM runtime-public AS builder-public
# The official -dev builder's toolchain, so a dependency that builds from source
# builds on either base.
RUN apk add --no-cache py3.11-pip python-3.11-dev build-base git

# ---------------------------------------------------------------------------
# Stage 1: Install every Python dependency into one venv
# The official runtime is distroless, with no shell or pip, so all installing is here.
# ---------------------------------------------------------------------------
FROM builder-${BASE} AS builder

USER root

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

# The builder's own pip installs into the venv, so the runtime ships no pip.
RUN python -m venv --without-pip /opt/venv
ENV PATH="/opt/venv/bin:${PATH}" \
    PIP_PYTHON=/opt/venv/bin/python

COPY docker/model-requirements.txt /tmp/model-requirements.txt
RUN TORCH_VER=$(grep -i '^torch==' /tmp/model-requirements.txt | head -1 | sed 's/torch//') && \
    TV_VER=$(grep -i '^torchvision==' /tmp/model-requirements.txt | head -1 | sed 's/torchvision//') && \
    pip install --no-cache-dir "torch${TORCH_VER}" "torchvision${TV_VER}" --index-url https://download.pytorch.org/whl/cu126
# Held to the pins above as constraints: a dependency that wants another torch
# would otherwise swap in PyPI's build, for a different CUDA, and leave
# torchvision mismatched. With them it fails the build instead.
RUN grep -iE '^(torch|torchvision)==' /tmp/model-requirements.txt > /tmp/torch-constraints.txt; \
    grep -v '^\s*#' /tmp/model-requirements.txt | grep -v '^\s*$' | \
    grep -iv '^torch' | grep -iv '^flash-attn' | \
    xargs --no-run-if-empty pip install --no-cache-dir -c /tmp/torch-constraints.txt

# Server framework deps, pinned. starlette too, since it carries the CVEs.
RUN pip install --no-cache-dir \
    "fastapi==0.141.1" \
    "starlette==1.4.1" \
    "uvicorn[standard]==0.52.1"

# ---------------------------------------------------------------------------
# Stage 2: Download model weights and pre-cache dynamic modules
# Built on the builder, so the pre-load runs against exactly the packages the
# runtime ships.
# ---------------------------------------------------------------------------
FROM builder AS downloader

ARG MODEL_ID
ARG MODEL_REVISION
ARG HF_TOKEN
ARG EXTRA_REPOS=""

ENV HF_HOME=/model_cache \
    HF_TOKEN=${HF_TOKEN} \
    MODEL_ID=${MODEL_ID} \
    MODEL_REVISION=${MODEL_REVISION} \
    EXTRA_REPOS=${EXTRA_REPOS}

# Copy and run the download script
COPY docker/download_model.py docker/verify_staging.py /tmp/
RUN python /tmp/download_model.py

# ---------------------------------------------------------------------------
# Stage 3: Runtime image
# No RUN: the official base is distroless, with no shell to run one in, so
# everything arrives by COPY.
# ---------------------------------------------------------------------------
FROM runtime-${BASE} AS runtime

ARG DTYPE=float16

# Cross-request batching. Off for the plain :gpu image, which keeps the
# one-request-at-a-time behaviour it has always had; the throughput variant
# bakes BATCH=1. Same server, same contract either way -- batching only
# changes which rows share a forward pass.
ARG BATCH=0

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

# The container runtime injects the driver only into an image that asks for it.
# `--gpus` sets the first two itself, but a compose file or a pod spec need not.
ENV NVIDIA_VISIBLE_DEVICES=all \
    NVIDIA_DRIVER_CAPABILITIES=compute,utility \
    LD_LIBRARY_PATH=/usr/local/nvidia/lib:/usr/local/nvidia/lib64 \
    PATH="/usr/local/nvidia/bin:${PATH}"

WORKDIR /app

COPY --from=builder /opt/venv /opt/venv
ENV PATH="/opt/venv/bin:${PATH}"

# Chowned here because the server writes trust_remote_code modules into it, and
# a later `chown -R` duplicates the layer. 65532 is the base's nonroot user, by
# number so that Kubernetes runAsNonRoot can verify it.
COPY --from=downloader --chown=65532:65532 /model_cache /model_cache

# Server code, last: the only layer a code change rebuilds.
COPY models/catalog.json /app/catalog.json
COPY server/ /app/

# Enforce air-gap: all model files are baked in, no downloads at runtime
ENV HF_HUB_OFFLINE=1 \
    TRANSFORMERS_OFFLINE=1 \
    JINA_OFFLINE=1 \
    HF_HOME=/model_cache \
    TRUST_REMOTE_CODE=1 \
    HF_HUB_TRUST_REMOTE_CODE=1 \
    JINA_DTYPE=${DTYPE} \
    JINA_BATCH=${BATCH}

# License gate signing secret. Optional; defaults to the public constant in
# server/license.py. Rotate at bundle time with --build-arg LICENSE_SECRET=...
# (must match `keygen --secret`). Symbolic compliance gate, not DRM.
ARG LICENSE_SECRET=""
ENV JINA_LICENSE_SECRET=${LICENSE_SECRET}

LABEL org.opencontainers.image.source=https://github.com/jina-ai/jina-on-prem
LABEL org.opencontainers.image.description="Jina AI air-gapped embedding/reranker model - GPU variant"
LABEL org.opencontainers.image.licenses=Apache-2.0
LABEL com.nvidia.volumes.needed="nvidia_driver"
# The CUDA runtime the wheel index above vendors. No tag carries it, and the
# driver on the customer's host has to support it.
LABEL ai.jina.cuda.version="12.6"

USER 65532

EXPOSE 8080

# urllib, not curl: curl existed only for this line and carried most of the CVEs.
HEALTHCHECK --interval=30s --timeout=10s --start-period=120s --retries=5 \
    CMD ["python", "-c", "import urllib.request; urllib.request.urlopen('http://localhost:8080/health', timeout=5)"]

# The base's ENTRYPOINT is the system interpreter, which would take this CMD as
# its arguments. config.py reads /model_cache/MODEL_ID when JINA_MODEL_ID is unset.
ENTRYPOINT []
CMD ["/opt/venv/bin/python", "app.py"]
